local function RTTT_fake_script() -- skibidi.LocalScript 
	local script = Instance.new('LocalScript', skibidi)

	local TextButton = script.Parent
	
	script.Parent.MouseButton1Down:Connect(function()
		local Pass = script.Parent.Parent:FindFirstChild("Pass")
		local Page1 = script.Parent.Parent:FindFirstChild("Page1")
	
		if Pass and Page1 and Pass.Text:match("teamfatguiv24byteamfatrevival") then
			Page1.Visible = true
			Pass.Visible = false
			TextButton.Visible = false
		end
	end)
end
coroutine.wrap(RTTT_fake_script)()
