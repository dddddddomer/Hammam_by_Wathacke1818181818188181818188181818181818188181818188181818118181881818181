local resizing = false
local startMouseY
local startHeight

handle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		resizing = true
		startMouseY = UIS:GetMouseLocation().Y
		startHeight = frame.Size.Y.Offset
	end
end)

UIS.InputChanged:Connect(function(input)
	if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
		local currentY = UIS:GetMouseLocation().Y
		local deltaY = currentY - startMouseY

		local newHeight = math.max(50, startHeight + deltaY)
		frame.Size = UDim2.new(frame.Size.X.Scale, frame.Size.X.Offset, 0, newHeight)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		resizing = false
	end
end)

