				RH.C0=clerp(RH.C0,cf(1,-.4,-.5)*angles(math.rad(0),math.rad(90),math.rad(0))*angles(math.rad(0),math.rad(0),math.rad(-25 + 5 * math.sin(sine/28))),.1)
