local function Highlight(str, keywords)
    local K = {}
    local S = str
    local Token = {
        ["="] = true, ["."] = true, [","] = true, ["("] = true, [")"] = true,
        ["["] = true, ["]"] = true, ["{"] = true, ["}"] = true, [":"] = true,
        ["*"] = true, ["/"] = true, ["+"] = true, ["-"] = true, ["%"] = true,
        [";"] = true, ["~"] = true
    }
    for _, v in pairs(keywords) do
        K[v] = true
    end

    S = S:gsub(".", function(c)
        if Token[c] then
            return " "
        else
            return c
        end
    end)

    S = S:gsub("%S+", function(c)
        if K[c] then
            return c
        else
            return (" "):rep(#c)
        end
    end)

    return S
end

local function hTokens(str)
    local Token = {
        ["="] = true, ["."] = true, [","] = true, ["("] = true, [")"] = true,
        ["["] = true, ["]"] = true, ["{"] = true, ["}"] = true, [":"] = true,
        ["*"] = true, ["/"] = true, ["+"] = true, ["-"] = true, ["%"] = true,
        [";"] = true, ["~"] = true
    }
    local A = ""
    str:gsub(".", function(c)
        if Token[c] then
            A = A .. c
        elseif c == "\n" then
            A = A .. "\n"
        elseif c == "\t" then
            A = A .. "\t"
        else
            A = A .. " "
        end
    end)
    return A
end

local function strings(str)
    local highlight = ""
    local quote = false
    str:gsub(".", function(c)
        if not quote and c == "\"" then
            quote = true
            highlight = highlight .. "\"" -- keep starting quote
            return
        elseif quote and c == "\"" then
            quote = false
            highlight = highlight .. "\"" -- keep ending quote
            return
        end

        if c == "\n" then
            highlight = highlight .. "\n"
        elseif c == "\t" then
            highlight = highlight .. "\t"
        elseif quote then
            highlight = highlight .. c
        else
            highlight = highlight .. " "
        end
    end)
    return highlight
end

local function comments(str)
    local ret = ""
    for line in str:gmatch("[^\r\n]*") do
        if line == "" then
            ret = ret .. "\n"
        else
            local comm = false
            for i = 1, #line do
                local ch = line:sub(i,i)
                local nextch = line:sub(i+1,i+1)
                if not comm and ch == "-" and nextch == "-" then
                    comm = true
                end
                if comm then
                    ret = ret .. ch
                else
                    ret = ret .. " "
                end
            end
            ret = ret .. "\n"
        end
    end
    return ret
end

