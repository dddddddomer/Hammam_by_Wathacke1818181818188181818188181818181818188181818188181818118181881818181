        elseif c == "\t" then
            A = A .. "\t"
        else
            A = A .. " "
        end
    end)
    return A
end

local function highlight_source(prop)
    if prop ~= "Text" then return end
    if typeof(Source.Text) ~= "string" then return end

    local txt = Source.Text:gsub("\13", ""):gsub("\t", "      ")
    Source.Keywords_.Text = Highlight(txt, lua_keywords)
    Source.Globals_.Text = Highlight(txt, global_env)
    Source.RemoteHighlight_.Text = Highlight(txt, {"FireServer", "fireServer", "InvokeServer", "invokeServer"})
    Source.Tokens_.Text = hTokens(txt)
    Source.Numbers_.Text = numbers(txt)
    Source.Strings_.Text = strings(txt)

    local lin = 1
    for _ in txt:gmatch("\n") do lin = lin + 1 end
    Lines.Text = ""
    for i = 1, lin do
        Lines.Text = Lines.Text .. tostring(i) .. "\n"
    end
end

highlight_source("Text")
Source.Changed:Connect(highlight_source)

