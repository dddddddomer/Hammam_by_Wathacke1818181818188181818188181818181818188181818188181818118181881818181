                    cl.Parent=Effects
                    local rot = ANGLES(MRANDOM()/10-MRANDOM()/10,MRANDOM()/10-MRANDOM()/10,MRANDOM()/10-MRANDOM()/10)
                    local pl = Vector3.new(MRANDOM()/10-MRANDOM()/10,MRANDOM()/10-MRANDOM()/10,MRANDOM()/10-MRANDOM()/10)
                    coroutine.wrap(function()
                        for i = 1,90 do
                            if not(cl and cl.Parent)then
                                break 
                            end
                            cl.CFrame=cl.CFrame*rot+Vector3.new(0,0.5-i/500,0)+pl
                            cl.Transparency=i/50
                            Swait()
                        end
                        if cl and cl.Parent then 
                            cl:Destroy()
                        end
                    end)()
                    Swait()
                elseif v:IsA("JointInstance")then
                    v.Enabled=false
                end
            end
        end
    end
    if MODEL and MODEL.Parent then
        pcall(function()
