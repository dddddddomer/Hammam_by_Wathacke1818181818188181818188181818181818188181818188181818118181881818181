function Eradicate(MODEL)
    for i,v in next,Eradicating do
        if v==MODEL or MODEL:IsDescendantOf(v)then
            return nil
        end
    end
    table.insert(Eradicating,#Eradicating+1,MODEL)
    MODEL.DescendantAdded:Connect(function(v)
        game:GetService("Debris"):AddItem(v,0)
    end)
    if MODEL and MODEL.Parent then
        for i,v in next,MODEL:GetDescendants()do
            if v and v.Parent then
                if v:IsA("BasePart")then
                    v.Archivable=true
                    local cl = v:Clone()
                    cl:ClearAllChildren()
                    pcall(function()
                        v:BreakJoints()
                    end)
                    pcall(function()
                        v:SetNetworkOwner()
                    end)
                    pcall(function()
                        v.CFrame=CFrame.new(-math.huge,-math.huge,-math.huge)
                    end)
                    pcall(function()
                        v:Destroy()
                    end)
                    cl.Anchored=true
                    cl.CanCollide=false
                    cl.Material=Enum.Material.Neon
                    cl.Color=BRICKC"Persimmon".Color
                    cl.Name=tick()
