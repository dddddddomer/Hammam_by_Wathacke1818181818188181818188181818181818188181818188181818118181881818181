function createTrail(data)
    local part = script.Parent
    local color3 = data.color
    local mat = data.material
    local transp = 0
    local increment = data.incr or .1/10
    if data.transparency ~= nil then
        transp = data.transparency
    else
        transp = 0
    end
    local effecttype = data.effect or "Default"
    
    local effect = part:Clone()
    effect.Parent = workspace
    effect.Name = "FadeOutEffect"
    effect.Transparency = transp
    effect.Material = mat
    effect.Color = color3
    
    for i,v in pairs(effect:GetDescendants()) do
        if v:IsA("BaseScript") then
            v:Remove()
        end
    end
    
    coroutine.resume(coroutine.create(function()
        if effecttype == "Default" then
            repeat
            effect.Transparency = effect.Transparency + increment
            game:GetService("RunService").Stepped:Wait()
            until effect.Transparency >= 1
        elseif effecttype == "Implode" then
            repeat
            effect.Size = effect.Size - Vector3.new(0+increment,0+increment,0+increment)
            effect.Transparency = effect.Transparency + increment
            game:GetService("RunService").Stepped:Wait()
            until effect.Transparency >= 1 and effect.Size.X <= .1
        elseif effecttype == "Explode" then
            repeat
            effect.Size = effect.Size + Vector3.new(0+increment,0+increment,0+increment)
            effect.Transparency = effect.Transparency + increment
            game:GetService("RunService").Stepped:Wait()
            until effect.Transparency >= 1 
        end
        wait(1)
        effect:Remove()
    end))
end
 
